{
    "branches": [
        "main",
        {
            "name": "dev",
            "prerelease": true
        }
    ],
    "plugins": [
        "@semantic-release/commit-analyzer",
        "@semantic-release/release-notes-generator",
        [
            "@semantic-release/changelog",
            {
                "changelogFile": "RELEASES.md",
                "changelogTitle": "# Suwayomi-WebUI release changelog\n\nGenerated by semantic-release from conventional commits.\nThe hand-curated Keep a Changelog history is kept separately in [CHANGELOG.md](./CHANGELOG.md)."
            }
        ],
        [
            "@semantic-release/exec",
            {
                "prepareCmd": "pnpm release:prepare"
            }
        ],
        [
            "@semantic-release/git",
            {
                "assets": [
                    "RELEASES.md"
                ],
                "message": "chore(release): ${nextRelease.version} [skip ci]\n\n${nextRelease.notes}"
            }
        ],
        [
            "@semantic-release/github",
            {
                "assets": [
                    {
                        "path": "buildZip/*.zip"
                    }
                ],
                "successComment": false,
                "failComment": false
            }
        ],
        [
            "@saithodev/semantic-release-backmerge",
            {
                "backmergeBranches": [
                    {
                        "from": "main",
                        "to": "dev"
                    }
                ],
                "clearWorkspace": true
            }
        ]
    ]
}
